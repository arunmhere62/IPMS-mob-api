FROM nginx:1.27-alpine

# Copy all API virtual-host configurations into place
COPY conf.d/*.conf /etc/nginx/conf.d/

# Copy the conditional entrypoint that enables dev vhost only when its cert exists
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Ensure the webroot for certbot exists (shared via named volume at runtime)
RUN mkdir -p /var/www/certbot

ENTRYPOINT ["/docker-entrypoint.sh"]
